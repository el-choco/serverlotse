FROM python:3.15.1-alpine3.24
WORKDIR /app
COPY server.py scan_index.py toolkit.py recovery.py docker_gateway.py auth.py localization.py admin_demo.py sensors_demo.py advanced_demo.py workbench_demo.py ./
COPY host_control.py admin_core.py admin_client.py sensors.py advanced.py automation.py bundle_backup.py proxy_control.py terminal_host.py deploy_host.py workbench.py docker_tools.py registry_check.py guardian.py backup_probe.py expert_tools.py network_extras.py docker_extras.py ./
COPY *.sh *.service ./
COPY static ./static
COPY tests ./tests
CMD ["python", "-m", "unittest", "discover", "-s", "tests", "-v"]
