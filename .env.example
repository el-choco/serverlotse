SERVERLOTSE_TOKEN=HIER-EINEN-ZUFAELLIGEN-SCHLUESSEL-EINTRAGEN
SERVERLOTSE_BIND=127.0.0.1
DATA_PATHS=/mnt/intenso2tb
# Keep enabled behind your HTTPS reverse proxy. 0 is only for private HTTP development.
SESSION_COOKIE_SECURE=1
# Reboot/shutdown through the internal authenticated host relay (Linux/systemd).
HOST_CONTROL_ENABLED=1
# Optional, only with compose.recovery.yaml:
# RECOVERY_PATH=/mnt/intenso2tb/serverlotse-rettung
